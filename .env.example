# PostgreSQL (используется docker-compose для сервиса db)
POSTGRES_USER=tcms
POSTGRES_PASSWORD=tcms
POSTGRES_DB=tcms

# Если подключаетесь к готовой БД (нативный Postgres или облако вроде
# Supabase/Neon) вместо контейнера db — задайте DATABASE_URL напрямую и
# уберите сервис db из docker-compose.yml либо не поднимайте его:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

SECRET_KEY=change-me-in-production

# Первый администратор (создаётся скриптом backend/app/seed.py)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=admin@tcms.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Хранилище загружаемых файлов (аттестаты сотрудников, документы проектов).
# Если все 4 переменные ниже не заданы — файлы хранятся на локальном диске
# под FILE_STORAGE_PATH (по умолчанию ./storage), как сегодня. Заполните их,
# чтобы перейти на S3-совместимое хранилище (например, Cloudflare R2) — это
# нужно на хостингах с эфемерным диском (см. план развёртывания), иначе
# файлы будут пропадать при каждом передеплое.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
