# PostgreSQL (используется docker-compose для сервиса db)
POSTGRES_USER=tcms
POSTGRES_PASSWORD=tcms
POSTGRES_DB=tcms

# Если подключаетесь к готовой БД (нативный Postgres или облако вроде
# Supabase/Neon) вместо контейнера db — задайте DATABASE_URL напрямую и
# уберите сервис db из docker-compose.yml либо не поднимайте его:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

SECRET_KEY=change-me-in-production

# Первый администратор (создаётся скриптом backend/app/seed.py)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=admin@tcms.local
SEED_ADMIN_PASSWORD=ChangeMe123!
